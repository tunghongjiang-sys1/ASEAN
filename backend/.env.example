OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT=30

# Optional: powers GET /place-info (destination info links: rating, website, maps).
# Get a key at https://console.cloud.google.com/google/maps-apis
GOOGLE_PLACES_API_KEY=

# Live flights + real prices via Google Flights (SerpAPI). Free tier ~100 searches/mo.
# Sign up at https://serpapi.com/ and paste your API key.
SERPAPI_API_KEY=

# Optional: live flights + prices via Amadeus self-service. Set BOTH id and secret.
# The free TEST environment is enough (~2000 req/mo). Create at https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Optional: if set, /flights also tries AviationStack live status data.
# Get a key at https://aviationstack.com/  (free tier available).
AVIATIONSTACK_API_KEY=

# Optional: if set, the /chat AND /flights endpoints require `Authorization: Bearer <secret>`.
# Set the same value in the expo client's .env as EXPO_PUBLIC_BACKEND_SECRET.
BACKEND_SECRET=

# Optional: per-client request budget (per minute) when BACKEND_SECRET is set.
# This is a per-process counter; with `uvicorn --workers N` each worker has its
# own bucket so the effective global limit is N x RATE_LIMIT_PER_MIN. set to 0
# to disable.
RATE_LIMIT_PER_MIN=30

PORT=8081
