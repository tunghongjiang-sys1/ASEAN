{
  "expo": {
    "name": "asean travel",
    "slug": "asean-travel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aseantaplogo.png",
    "userInterfaceStyle": "light",
    "scheme": "aseantravel",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "we use a soft 5km circle around your location to personalise nearby travel ideas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000080",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/aseantaplogo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "we use a soft 5km circle around your location to personalise nearby travel ideas."
        }
      ]
    ]
  }
}
