[TEMPLATE]
# The python backend URL. same address for chat and flights.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# If BACKEND_SECRET is set on the server, mirror it here so the SDK sends
# `Authorization: Bearer <secret>` on every fetch.
EXPO_PUBLIC_BACKEND_SECRET=

# Optional: wire real Google OAuth later; demo google login works without this.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
